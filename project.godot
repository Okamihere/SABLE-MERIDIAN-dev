; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

csg_blockout/language_override="pt"
csg_blockout/material_preset=1
csg_blockout/player_metrics/character_height=1.85
csg_blockout/player_metrics/capsule_radius=0.42
csg_blockout/player_metrics/single_jump_height=1.4
csg_blockout/player_metrics/sprint_jump_distance=5.5
csg_blockout/player_metrics/walk_speed=6.5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="SABLE MERIDIAN"
config/version="0.1-prototype"
run/main_scene="res://scenes/ui/press_start.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

GameManager="*res://scripts/systems/game_manager.gd"
CelShading="*res://scripts/systems/cel_shading.gd"
Progression="*res://scripts/systems/progression.gd"
GraphicsSettings="*res://scripts/systems/graphics_settings.gd"
UiSfx="*res://scripts/systems/ui_sfx.gd"
PauseMenu="*res://scenes/ui/pause_menu.tscn"
NpcInteraction="*res://scenes/ui/npc_interaction.tscn"
AreaTransition="*res://scenes/ui/area_transition.tscn"
MusicManager="*res://scripts/systems/music_manager.gd"
PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=4
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/phantom_camera/plugin.cfg", "res://addons/sable_wall_painter/plugin.cfg", "res://addons/csg_blockout/plugin.cfg")

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="PlayerBody"
3d_physics/layer_3="EnemyBody"
3d_physics/layer_4="PlayerHitbox"
3d_physics/layer_5="EnemyHitbox"
3d_physics/layer_6="Hurtbox"

[physics]

common/enable_pause_aware_picking=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
